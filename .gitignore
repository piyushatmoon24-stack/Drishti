# ==========================================
# DRISHTI: Assistive Smart Stick .gitignore
# ==========================================

# Local Archive & Historical Backups (Kept on local machine only)
archive/

# Raw Dataset Images & Compressed Archives
datasets/
*.zip.tmp
*.zip

# Compiled Build Artifacts
**/build/
*.bin.merged.bin
*.elf
*.o
*.d
*.a

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Temporary Audio & Test Scratch Files
test.wav
test_voice.wav
*.tmp

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
