# ==========================================
# DRISHTI: Assistive Smart Stick .gitignore
# ==========================================

# Raw Dataset Images & Zips (Store on Roboflow / Cloud Storage)
datasets/
*.zip.tmp

# Compiled Build Artifacts
**/build/
*.bin.merged.bin
*.elf
*.o
*.d
*.a

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Temporary Audio & Test Scratch Files
test.wav
test_voice.wav
*.tmp

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
