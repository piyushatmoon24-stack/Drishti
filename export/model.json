{
  "version": "2.0.0",
  "name": "drishti-fomo-8class",
  "description": "8-Class Edge Vision AI Model for Seeed Grove Vision AI V2 (Himax WiseEye2 + Ethos-U55 NPU)",
  "category": "Object Detection",
  "algorithm": "FOMO-MobileNetV2-0.35",
  "input_type": "image",
  "image_type": "rgb",
  "input_shape": [1, 128, 128, 3],
  "score_threshold": 0.35,
  "classes": [
    "car",
    "chair",
    "door",
    "motorcycle",
    "person",
    "pole",
    "stairs",
    "table"
  ],
  "labels": {
    "0": "car",
    "1": "chair",
    "2": "door",
    "3": "motorcycle",
    "4": "person",
    "5": "pole",
    "6": "stairs",
    "7": "table"
  },
  "metrics": {
    "macro_precision": 75.37,
    "inference_latency_ms": 3.0,
    "hardware_target": "Arm Ethos-U55"
  }
}
